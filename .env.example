GEMINI_API_KEY=your_gemini_api_key

# true = cheap development model only
# false = production model fallback chain
GEMINI_DEV_MODE=true

# Used only when GEMINI_DEV_MODE=true
GEMINI_DEV_MODEL=gemini-3.5-flash-lite

# CROO provider
SHIPSPARK_BASE_URL=http://localhost:3000
CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws
CROO_RPC_URL=
CROO_SDK_KEY=
